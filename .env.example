# DeepSeek (OpenAI compatible)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Remote DB / Redis (192.168.80.156)
# 具体库名/端口下阶段再确认，先占位
POSTGRES_DSN=postgresql://admin:123456@192.168.80.156:5432/postgres
REDIS_URL=redis://192.168.80.156:6379/0
# PG_DSN 与 POSTGRES_DSN 同义，优先读 PG_DSN；库名确认后替换 /postgres
# PG_DSN=postgresql://admin:123456@192.168.80.156:5432/postgres

# Context assembly budget (tokens; assembler enforces usage <= total)
# CONTEXT_BUDGET_TOKENS=8000
# CONTEXT_RESERVED_TOKENS=1000

# Context compression (spec#2: assembler triggers provider.compress when usage > ratio*available)
# CONTEXT_COMPRESS_RATIO=0.8
# CONVERSATION_KEEP_RECENT=3
# OBSERVATION_KEEP_RECENT=5
